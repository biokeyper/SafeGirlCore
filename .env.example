NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://safegirl_user:safegirl_password@postgres:5432/safegirl_db

# Blockchain Configuration
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
# Private key of the backend wallet used to sign transactions
PRIVATE_KEY=your_wallet_private_key_here
# Address of the deployed SafeGirl smart contract
DEPLOYED_CONTRACT_ADDRESS=0x...

# IPFS Configuration - Pinata
PINATA_JWT=your_pinata_jwt_here

# Server Settings
MAX_PAYLOAD_SIZE=10485760
REQUEST_TIMEOUT=30000

# Country Configuration (for phone number normalization)
COUNTRY_CODE=256

# Mobile App Configuration
APP_SCHEME=safegirl

# Logging
LOG_LEVEL=info

# JWT Authentication
JWT_SECRET=your_jwt_secret_here

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Email (Gmail SMTP)
EMAIL_FROM=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here

# Encryption
ENCRYPTION_MASTER_KEY=your_64_char_hex_key_here
