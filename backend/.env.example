# SafeGirl Backend Environment Variables
# Copy this to .env and fill in with real values for local development
# DO NOT commit .env to git - use GitHub Secrets for production/staging

# Environment
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/safegirl_db

# Blockchain (Polygon)
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
PRIVATE_KEY=your_private_key_here_32_hex_chars
DEPLOYED_CONTRACT_ADDRESS=0x8C7eC5A70f442Ddd1E002493624e95c4ecFa2Ee6

# IPFS (Pinata)
PINATA_JWT=your_pinata_jwt_token_here

# Server Configuration
MAX_PAYLOAD_SIZE=10485760
REQUEST_TIMEOUT=30000

# Country Code (Uganda)
COUNTRY_CODE=256

# Mobile App
APP_SCHEME=safegirlapp

# Logging
LOG_LEVEL=info

# Authentication
JWT_SECRET=your_jwt_secret_here_32_bytes_base64
# JWT_SECRET_PREVIOUS=old_jwt_secret_for_rotation_only (optional - remove after 7 days)

# Twilio SMS Service
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Email (Gmail)
EMAIL_FROM=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# Encryption (with key rotation support)
ENCRYPTION_MASTER_KEY=your_encryption_key_here_32_bytes_hex
# ENCRYPTION_MASTER_KEY_PREVIOUS=old_key_for_rotation_only (optional - remove after migration)
# ENCRYPTION_KEY_VERSION=1 (optional - increment on rotation)

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Optional: Confirmation Scheduler
CONFIRMATION_THRESHOLD=12
POLL_INTERVAL_MS=30000
