# SafeGirl Backend - Production Environment
# All values MUST be injected via GitHub Secrets
# NEVER commit real secrets to this file

NODE_ENV=production
PORT=3001

# Database (production)
# REQUIRED: Set in GitHub Secrets
# DATABASE_URL=postgresql://prod_user:SECURE_PASSWORD@prod-host:5432/safegirl_db

# Blockchain (Polygon Mainnet - REAL MONEY)
# REQUIRED: Set in GitHub Secrets
# POLYGON_RPC_URL=https://polygon-rpc.com (Mainnet)
# OR: POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/ (Testnet)
# REQUIRED: PRIVATE_KEY (production wallet)
# REQUIRED: DEPLOYED_CONTRACT_ADDRESS (production contract)

# IPFS (Pinata - production tier)
# REQUIRED: PINATA_JWT (production API key)

# Server Configuration
MAX_PAYLOAD_SIZE=10485760
REQUEST_TIMEOUT=30000

# Country Code
COUNTRY_CODE=256

# Mobile App
APP_SCHEME=safegirlapp

# Logging (less verbose in production)
LOG_LEVEL=warn

# Authentication
# REQUIRED: JWT_SECRET (rotate weekly, see JWT_ROTATION_STRATEGY.md)

# Twilio SMS Service (production number)
# REQUIRED: TWILIO_ACCOUNT_SID
# REQUIRED: TWILIO_AUTH_TOKEN
# REQUIRED: TWILIO_PHONE_NUMBER (production number, e.g., +1234567890)

# Email (production account)
# REQUIRED: EMAIL_FROM (production email address)
# REQUIRED: EMAIL_PASSWORD (production app password or SMTP password)

# Encryption
# REQUIRED: ENCRYPTION_MASTER_KEY (rotate on key compromise, see ENCRYPTION_KEY_ROTATION.md)

# Frontend URL (production app URL)
# REQUIRED: FRONTEND_URL=https://app.safegirl.com (or your domain)

# Optional: Confirmation Scheduler
CONFIRMATION_THRESHOLD=12
POLL_INTERVAL_MS=30000
