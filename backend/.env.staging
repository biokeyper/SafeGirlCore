# SafeGirl Backend - Staging Environment
# Use GitHub Secrets for actual values
# This file is a template showing which vars are needed

NODE_ENV=staging
PORT=3001

# Database (staging)
# Get from: GitHub Secrets → DATABASE_URL
# DATABASE_URL will be injected by Render from GitHub Secrets

# Blockchain (Polygon Mumbai testnet - use for testing)
# POLYGON_AMOY_RPC_URL will be injected by Render from GitHub Secrets
# PRIVATE_KEY will be injected by Render from GitHub Secrets
# DEPLOYED_CONTRACT_ADDRESS will be injected by Render from GitHub Secrets

# IPFS (Pinata - use same key as dev, or create staging key)
# PINATA_JWT will be injected by Render from GitHub Secrets

# Server Configuration
MAX_PAYLOAD_SIZE=10485760
REQUEST_TIMEOUT=30000

# Country Code (Uganda)
COUNTRY_CODE=256

# Mobile App
APP_SCHEME=safegirlapp

# Logging
LOG_LEVEL=info

# Authentication
# JWT_SECRET will be injected by Render from GitHub Secrets

# Twilio SMS Service (use staging number)
# TWILIO_ACCOUNT_SID will be injected by Render from GitHub Secrets
# TWILIO_AUTH_TOKEN will be injected by Render from GitHub Secrets
# TWILIO_PHONE_NUMBER will be injected by Render from GitHub Secrets

# Email (use staging email account)
# EMAIL_FROM will be injected by Render from GitHub Secrets
# EMAIL_PASSWORD will be injected by Render from GitHub Secrets

# Encryption
# ENCRYPTION_MASTER_KEY will be injected by Render from GitHub Secrets

# Frontend URL (staging app URL)
# FRONTEND_URL will be injected by Render from GitHub Secrets

# Optional: Confirmation Scheduler
CONFIRMATION_THRESHOLD=12
POLL_INTERVAL_MS=30000
