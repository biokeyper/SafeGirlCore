{
  "watch": [".", "routes", "controllers", "services", "middleware", "utils", "config", "types"],
  "ignore": ["node_modules", "logs", "*.log", "db/migrations", "dist"],
  "ext": "ts,json",
  "exec": "tsx",
  "script": "server.ts",
  "delay": 500,
  "verbose": true,
  "env": {
    "NODE_ENV": "development"
  }
}
